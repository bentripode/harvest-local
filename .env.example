# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# App -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase ----------------------------------------------------------------
# Local dev (npx supabase start) prints these. For a hosted project they are in
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (TEST MODE) ----------------------------------------------------------
# Dashboard > Developers > API keys (toggle "Test mode" on).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# `stripe listen` prints this when you start forwarding webhooks locally.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: a second endpoint secret if you forward Connect (connected-account) events separately.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# The recurring $20/mo Price id. Create it once:
#   npm run stripe:setup        (see scripts/stripe-setup.ts)
# or in the dashboard: Products > add product > recurring $20/month.
STRIPE_SUBSCRIPTION_PRICE_ID="price_..."
STRIPE_SELLER_TRIAL_DAYS="90"

# Inngest (background jobs) -------------------------------------------------
# Not needed for local dev — `npm run inngest:dev` runs the Dev Server without keys.
# For a deploy: inngest.com > your app > copy the Event Key and Signing Key.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Email (Resend) ---------------------------------------------------------------
# Optional. With no key, notification-dispatch logs the email instead of sending.
# resend.com > API Keys. EMAIL_FROM must be a verified domain in prod; the default
# "onboarding@resend.dev" works for test sends to your own address.
RESEND_API_KEY=""
EMAIL_FROM="Harvest Local <onboarding@resend.dev>"

# SMS (Twilio) ---------------------------------------------------------------
# Optional. With any of these unset, notification-dispatch logs the text instead of sending.
# twilio.com/console > Account SID + Auth Token; buy/verify a sending number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""   # E.164, e.g. +15125550123

# Mapbox --------------------------------------------------------------------
# NEXT_PUBLIC_ token: the browser map (GL JS). Needed when the map/gallery lands.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Server token for Geocoding + Directions (delivery mileage quoting). Optional — falls back to the
# public token. In prod use a secret, URL-unrestricted token with the Geocoding + Directions scopes.
# With neither token set, delivery checkout is unavailable; pickup works as normal.
MAPBOX_TOKEN=""

# Sentry (error tracking) -------------------------------------------------------
# Optional. With no DSN the SDK is inert and the app is unchanged.
# sentry.io > your project > Settings > Client Keys (DSN). Same value both vars.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only — for source-map upload so stack traces are readable. Leave blank
# locally. sentry.io > Settings > Auth Tokens (scope: project:releases).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
